(* Versión equivalente para yalexgen (no sustituye al slr-2.yal del catedrático). *)

{
}

let delim = [' ' '\t' '\n' '\r']
let ws = delim+
let letter = ['A'-'Z' 'a'-'z']
let digit = ['0'-'9']
let digits = digit+
let id = letter(letter|digit)*
let number = digits('.'digits)?('E'['+' '-']?digits)?

rule tokens =
    ws        { return lexbuf; }
  | id        { return ID; }
  | number    { return NUMBER; }
  | '+'       { return PLUS; }
  | '-'       { return MINUS; }
  | '*'       { return TIMES; }
  | '/'       { return DIV; }
  | '('       { return LPAREN; }
  | ')'       { return RPAREN; }
  | eof       { return EOF; }

{
}
