(* Versión equivalente para yalexgen (no sustituye al slr-3.yal del catedrático). *)

{
}

let delim = [' ' '\t' '\n' '\r']
let ws = delim+
let digit = ['0'-'9']
let digits = digit+
let number = digits('.'digits)?('E'['+' '-']?digits)?

rule tokens =
    ws        { return lexbuf; }
  | number    { return NUMBER; }
  | '+'       { return PLUS; }
  | '*'       { return TIMES; }
  | '('       { return LPAREN; }
  | ')'       { return RPAREN; }
  | eof       { return EOF; }

{
}
