(* Versión equivalente para yalexgen (no sustituye al slr-1.yal del catedrático). *)

{
}

let delim = [' ' '\t' '\n' '\r']
let ws = delim+
let letter = ['A'-'Z' 'a'-'z']
let digit = ['0'-'9']
let id = letter(letter|digit)*

rule tokens =
    ws        { return lexbuf; }
  | id        { return ID; }
  | '+'       { return PLUS; }
  | '*'       { return TIMES; }
  | '('       { return LPAREN; }
  | ')'       { return RPAREN; }
  | eof       { return EOF; }

{
}
